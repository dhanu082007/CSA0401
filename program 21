#include <stdio.h>

int main()
{
    int blockSize[20], processSize[20];
    int allocation[20];
    int blocks, processes;
    int i, j, worst;

    printf("Enter number of memory blocks: ");
    scanf("%d", &blocks);

    printf("Enter size of each memory block:\n");
    for (i = 0; i < blocks; i++)
    {
        printf("Block %d: ", i + 1);
        scanf("%d", &blockSize[i]);
    }

    printf("\nEnter number of processes: ");
    scanf("%d", &processes);

    printf("Enter size of each process:\n");
    for (i = 0; i < processes; i++)
    {
        printf("Process %d: ", i + 1);
        scanf("%d", &processSize[i]);
        allocation[i] = -1;
    }

    // Worst Fit Allocation
    for (i = 0; i < processes; i++)
    {
        worst = -1;

        for (j = 0; j < blocks; j++)
        {
            if (blockSize[j] >= processSize[i])
            {
                if (worst == -1 || blockSize[j] > blockSize[worst])
                {
                    worst = j;
                }
            }
        }

        if (worst != -1)
        {
            allocation[i] = worst;
            blockSize[worst] -= processSize[i];
        }
    }

    // Display result
    printf("\nProcess\tProcess Size\tBlock Allocated\n");

    for (i = 0; i < processes; i++)
    {
        printf("P%d\t%d\t\t", i + 1, processSize[i]);

        if (allocation[i] != -1)
            printf("B%d\n", allocation[i] + 1);
        else
            printf("Not Allocated\n");
    }

    return 0;
}
