#include <stdio.h>

#define SIZE 5

int mutex = 1;
int full = 0;
int empty = SIZE;
int x = 0;

void wait(int *s)
{
    (*s)--;
}

void signal(int *s)
{
    (*s)++;
}

void producer()
{
    if ((mutex == 1) && (empty != 0))
    {
        wait(&empty);
        wait(&mutex);

        x++;
        printf("Producer produces item %d\n", x);

        signal(&mutex);
        signal(&full);
    }
    else
    {
        printf("Buffer is Full!\n");
    }
}

void consumer()
{
    if ((mutex == 1) && (full != 0))
    {
        wait(&full);
        wait(&mutex);

        printf("Consumer consumes item %d\n", x);
        x--;

        signal(&mutex);
        signal(&empty);
    }
    else
    {
        printf("Buffer is Empty!\n");
    }
}

int main()
{
    int choice;

    while (1)
    {
        printf("\n1. Produce");
        printf("\n2. Consume");
        printf("\n3. Exit");

        printf("\nEnter your choice: ");
        scanf("%d", &choice);

        switch (choice)
        {
            case 1:
                producer();
                break;

            case 2:
                consumer();
                break;

            case 3:
                return 0;

            default:
                printf("Invalid Choice!\n");
        }
    }

    return 0;
}
