#include <stdio.h>

#define N 5

int state[N];

#define THINKING 0
#define HUNGRY 1
#define EATING 2

int LEFT(int i)
{
    return (i + N - 1) % N;
}

int RIGHT(int i)
{
    return (i + 1) % N;
}

void test(int i)
{
    if(state[i] == HUNGRY &&
       state[LEFT(i)] != EATING &&
       state[RIGHT(i)] != EATING)
    {
        state[i] = EATING;
        printf("Philosopher %d takes forks %d and %d\n",
               i + 1, LEFT(i) + 1, i + 1);

        printf("Philosopher %d is Eating\n", i + 1);
    }
}

void take_fork(int i)
{
    state[i] = HUNGRY;

    printf("\nPhilosopher %d is Hungry\n", i + 1);

    test(i);

    if(state[i] != EATING)
    {
        printf("Philosopher %d is Waiting\n", i + 1);
    }
}

void put_fork(int i)
{
    state[i] = THINKING;

    printf("Philosopher %d puts forks %d and %d down\n",
           i + 1, LEFT(i) + 1, i + 1);

    printf("Philosopher %d is Thinking\n", i + 1);

    test(LEFT(i));
    test(RIGHT(i));
}

int main()
{
    int i;

    for(i = 0; i < N; i++)
        state[i] = THINKING;

    printf("Dining Philosophers Problem Simulation\n");

    for(i = 0; i < N; i++)
        take_fork(i);

    printf("\n");

    for(i = 0; i < N; i++)
        put_fork(i);

    return 0;
}
