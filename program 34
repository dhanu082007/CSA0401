#include <stdio.h>

#define MAX 50

int main()
{
    int records[MAX];
    int n, i, search, found = 0;

    printf("Enter the number of records: ");
    scanf("%d", &n);

    printf("Enter the records:\n");

    for (i = 0; i < n; i++)
    {
        printf("Record %d: ", i + 1);
        scanf("%d", &records[i]);
    }

    printf("\nRecords stored sequentially:\n");

    for (i = 0; i < n; i++)
    {
        printf("Block %d -> Record %d\n", i + 1, records[i]);
    }

    // Search for a record
    printf("\nEnter the record to access: ");
    scanf("%d", &search);

    printf("\nReading records sequentially...\n");

    for (i = 0; i < n; i++)
    {
        printf("Reading Record %d: %d\n", i + 1, records[i]);

        if (records[i] == search)
        {
            printf("\nRecord %d found at position %d.\n",
                   search, i + 1);
            found = 1;
            break;
        }
    }

    if (!found)
    {
        printf("\nRecord %d not found in the file.\n", search);
    }

    return 0;
}
