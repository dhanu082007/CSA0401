#include <stdio.h>

int main()
{
    int nb, np;
    int block[20], process[20];
    int b[20], p[20];
    int allocation[20];
    int i, j, choice;

    printf("Enter Number of Memory Blocks: ");
    scanf("%d", &nb);

    printf("Enter Number of Processes: ");
    scanf("%d", &np);

    printf("\nEnter Memory Block Sizes:\n");
    for(i = 0; i < nb; i++)
        scanf("%d", &block[i]);

    printf("\nEnter Process Sizes:\n");
    for(i = 0; i < np; i++)
        scanf("%d", &process[i]);

    printf("\n1. First Fit");
    printf("\n2. Best Fit");
    printf("\n3. Worst Fit");
    printf("\nEnter your choice: ");
    scanf("%d", &choice);

    for(i = 0; i < nb; i++)
        b[i] = block[i];

    for(i = 0; i < np; i++)
        allocation[i] = -1;

    switch(choice)
    {
        case 1:     // First Fit
            for(i = 0; i < np; i++)
            {
                for(j = 0; j < nb; j++)
                {
                    if(b[j] >= process[i])
                    {
                        allocation[i] = j;
                        b[j] -= process[i];
                        break;
                    }
                }
            }
            break;

        case 2:     // Best Fit
            for(i = 0; i < np; i++)
            {
                int best = -1;

                for(j = 0; j < nb; j++)
                {
                    if(b[j] >= process[i])
                    {
                        if(best == -1 || b[j] < b[best])
                            best = j;
                    }
                }

                if(best != -1)
                {
                    allocation[i] = best;
                    b[best] -= process[i];
                }
            }
            break;

        case 3:     // Worst Fit
            for(i = 0; i < np; i++)
            {
                int worst = -1;

                for(j = 0; j < nb; j++)
                {
                    if(b[j] >= process[i])
                    {
                        if(worst == -1 || b[j] > b[worst])
                            worst = j;
                    }
                }

                if(worst != -1)
                {
                    allocation[i] = worst;
                    b[worst] -= process[i];
                }
            }
            break;

        default:
            printf("Invalid Choice!");
            return 0;
    }

    printf("\nProcess No.\tProcess Size\tBlock No.\n");

    for(i = 0; i < np; i++)
    {
        printf("%d\t\t%d\t\t", i + 1, process[i]);

        if(allocation[i] != -1)
            printf("%d\n", allocation[i] + 1);
        else
            printf("Not Allocated\n");
    }

    return 0;
}
