#include <stdio.h>

int main()
{
    int pages[50], frames[10];
    int n, f;
    int i, j, k;
    int pageFaults = 0, pageHits = 0;
    int found, empty;
    int replaceIndex, farthest, nextUse;

    printf("Enter the number of pages in reference string: ");
    scanf("%d", &n);

    printf("Enter the reference string:\n");
    for (i = 0; i < n; i++)
    {
        scanf("%d", &pages[i]);
    }

    printf("Enter the number of frames: ");
    scanf("%d", &f);

    // Initialize frames
    for (i = 0; i < f; i++)
    {
        frames[i] = -1;
    }

    printf("\nPage\tFrames\t\tStatus\n");
    printf("--------------------------------------\n");

    for (i = 0; i < n; i++)
    {
        found = 0;

        // Check if page is already present
        for (j = 0; j < f; j++)
        {
            if (frames[j] == pages[i])
            {
                found = 1;
                break;
            }
        }

        // Page Hit
        if (found)
        {
            pageHits++;
        }
        else
        {
            pageFaults++;
            empty = -1;

            // Check for an empty frame
            for (j = 0; j < f; j++)
            {
                if (frames[j] == -1)
                {
                    empty = j;
                    break;
                }
            }

            // If an empty frame exists
            if (empty != -1)
            {
                frames[empty] = pages[i];
            }
            else
            {
                farthest = -1;
                replaceIndex = -1;

                // Find the page used farthest in the future
                for (j = 0; j < f; j++)
                {
                    nextUse = -1;

                    for (k = i + 1; k < n; k++)
                    {
                        if (frames[j] == pages[k])
                        {
                            nextUse = k;
                            break;
                        }
                    }

                    // If page will never be used again
                    if (nextUse == -1)
                    {
                        replaceIndex = j;
                        break;
                    }

                    // Find the farthest next use
                    if (nextUse > farthest)
                    {
                        farthest = nextUse;
                        replaceIndex = j;
                    }
                }

                frames[replaceIndex] = pages[i];
            }
        }

        // Display current frames
        printf("%d\t", pages[i]);

        for (j = 0; j < f; j++)
        {
            if (frames[j] == -1)
                printf("- ");
            else
                printf("%d ", frames[j]);
        }

        if (found)
            printf("\tPage Hit");
        else
            printf("\tPage Fault");

        printf("\n");
    }

    printf("\nTotal Page Faults = %d\n", pageFaults);
    printf("Total Page Hits   = %d\n", pageHits);

    return 0;
}
