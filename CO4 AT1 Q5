#include <stdio.h>
#include <stdlib.h>

#define MAX 1000

int disk[MAX];

/* Contiguous Allocation */
int contiguous(int total, int size, int allocated[])
{
    int i, count = 0, start = -1;

    for (i = 0; i < total; i++)
    {
        if (disk[i] == 0)
        {
            count++;

            if (count == size)
            {
                start = i - size + 1;
                break;
            }
        }
        else
        {
            count = 0;
        }
    }

    if (start == -1)
        return 0;

    for (i = 0; i < size; i++)
    {
        allocated[i] = start + i;
        disk[start + i] = 1;
    }

    return 1;
}

/* Indexed Allocation */
int indexed(int total, int size, int allocated[])
{
    int i, count = 0;
    int indexBlock = -1;

    /* Find index block */
    for (i = 0; i < total; i++)
    {
        if (disk[i] == 0)
        {
            indexBlock = i;
            disk[i] = 1;
            break;
        }
    }

    if (indexBlock == -1)
        return 0;

    /* Allocate data blocks */
    for (i = 0; i < total && count < size; i++)
    {
        if (disk[i] == 0)
        {
            allocated[count] = i;
            disk[i] = 1;
            count++;
        }
    }

    if (count < size)
        return 0;

    printf("Index Block: %d\n", indexBlock);

    return 1;
}

/* FCFS Scheduling */
int fcfs(int request[], int n, int head)
{
    int i, current = head;
    int movement = 0;

    printf("FCFS Sequence: %d", head);

    for (i = 0; i < n; i++)
    {
        movement += abs(current - request[i]);
        current = request[i];

        printf(" -> %d", current);
    }

    printf("\nTotal Seek Time: %d\n", movement);

    return movement;
}

/* SSTF Scheduling */
int sstf(int request[], int n, int head)
{
    int visited[MAX] = {0};
    int i, count;
    int current = head;
    int movement = 0;
    int min, index;

    printf("SSTF Sequence: %d", head);

    for (count = 0; count < n; count++)
    {
        min = 999999;
        index = -1;

        for (i = 0; i < n; i++)
        {
            if (!visited[i])
            {
                if (abs(current - request[i]) < min)
                {
                    min = abs(current - request[i]);
                    index = i;
                }
            }
        }

        visited[index] = 1;

        movement += abs(current - request[index]);
        current = request[index];

        printf(" -> %d", current);
    }

    printf("\nTotal Seek Time: %d\n", movement);

    return movement;
}

int main()
{
    int total, fileSize, head;
    int method, schedule;
    int allocated[MAX];
    int i, result;
    int seek;

    printf("Enter total number of disk blocks: ");
    scanf("%d", &total);

    printf("Enter file size: ");
    scanf("%d", &fileSize);

    printf("\nAllocation Method\n");
    printf("1. Contiguous\n");
    printf("2. Indexed\n");
    printf("Enter choice: ");
    scanf("%d", &method);

    printf("\nDisk Scheduling Method\n");
    printf("1. FCFS\n");
    printf("2. SSTF\n");
    printf("Enter choice: ");
    scanf("%d", &schedule);

    printf("\nEnter initial head position: ");
    scanf("%d", &head);

    /* Initialize disk */
    for (i = 0; i < total; i++)
        disk[i] = 0;

    /* Allocation */
    if (method == 1)
    {
        result = contiguous(total, fileSize, allocated);

        if (!result)
        {
            printf("\nContiguous allocation failed.\n");
            return 0;
        }
    }
    else if (method == 2)
    {
        result = indexed(total, fileSize, allocated);

        if (!result)
        {
            printf("\nIndexed allocation failed.\n");
            return 0;
        }
    }
    else
    {
        printf("Invalid allocation method.\n");
        return 0;
    }

    printf("\nAllocated Blocks:\n");

    for (i = 0; i < fileSize; i++)
        printf("%d ", allocated[i]);

    printf("\n\n--- Disk Scheduling ---\n");

    /* Scheduling */
    if (schedule == 1)
    {
        seek = fcfs(allocated, fileSize, head);
    }
    else if (schedule == 2)
    {
        seek = sstf(allocated, fileSize, head);
    }
    else
    {
        printf("Invalid scheduling method.\n");
        return 0;
    }

    printf("\nFinal Result\n");
    printf("----------------------\n");

    if (method == 1)
        printf("Allocation: Contiguous\n");
    else
        printf("Allocation: Indexed\n");

    if (schedule == 1)
        printf("Scheduling: FCFS\n");
    else
        printf("Scheduling: SSTF\n");

    printf("Total Seek Time: %d\n", seek);

    return 0;
}
