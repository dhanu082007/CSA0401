#include <stdio.h>

int main()
{
    int pages[50], frames[10], recent[10];
    int n, f;
    int i, j, k;
    int pageFaults = 0, pageHits = 0;
    int found, least, lruIndex;

    printf("Enter the number of pages in reference string: ");
    scanf("%d", &n);

    printf("Enter the reference string:\n");
    for (i = 0; i < n; i++)
    {
        scanf("%d", &pages[i]);
    }

    printf("Enter the number of frames: ");
    scanf("%d", &f);

    // Initialize frames and recent array
    for (i = 0; i < f; i++)
    {
        frames[i] = -1;
        recent[i] = 0;
    }

    printf("\nPage\tFrames\t\tStatus\n");
    printf("--------------------------------------\n");

    for (i = 0; i < n; i++)
    {
        found = 0;

        // Check whether page is already present
        for (j = 0; j < f; j++)
        {
            if (frames[j] == pages[i])
            {
                found = 1;
                recent[j] = i + 1;
                break;
            }
        }

        // Page Hit
        if (found)
        {
            pageHits++;
        }
        else
        {
            pageFaults++;

            // Check for an empty frame
            for (j = 0; j < f; j++)
            {
                if (frames[j] == -1)
                {
                    frames[j] = pages[i];
                    recent[j] = i + 1;
                    found = 2;
                    break;
                }
            }

            // No empty frame - find least recently used page
            if (found != 2)
            {
                least = recent[0];
                lruIndex = 0;

                for (j = 1; j < f; j++)
                {
                    if (recent[j] < least)
                    {
                        least = recent[j];
                        lruIndex = j;
                    }
                }

                frames[lruIndex] = pages[i];
                recent[lruIndex] = i + 1;
            }
        }

        // Display frames
        printf("%d\t", pages[i]);

        for (k = 0; k < f; k++)
        {
            if (frames[k] == -1)
                printf("- ");
            else
                printf("%d ", frames[k]);
        }

        if (found == 1)
            printf("\tPage Hit");
        else
            printf("\tPage Fault");

        printf("\n");
    }

    printf("\nTotal Page Faults = %d\n", pageFaults);
    printf("Total Page Hits   = %d\n", pageHits);

    return 0;
}
