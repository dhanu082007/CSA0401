#include <stdio.h>

#define MAX 1000

int main()
{
    int disk[MAX], total, fileSize, method;
    int i, j, start, count, indexBlock;

    printf("Enter total number of disk blocks: ");
    scanf("%d", &total);

    printf("Enter file size (number of blocks): ");
    scanf("%d", &fileSize);

    printf("\nAllocation Methods\n");
    printf("1. Contiguous\n");
    printf("2. Linked\n");
    printf("3. Indexed\n");
    printf("Enter method: ");
    scanf("%d", &method);

    if (total > MAX || fileSize > total)
    {
        printf("Invalid input / Insufficient disk space.\n");
        return 0;
    }

    /* Initialize all blocks as free */
    for (i = 0; i < total; i++)
        disk[i] = 0;

    /* CONTIGUOUS */
    if (method == 1)
    {
        start = -1;
        count = 0;

        for (i = 0; i < total; i++)
        {
            if (disk[i] == 0)
            {
                count++;

                if (count == fileSize)
                {
                    start = i - fileSize + 1;
                    break;
                }
            }
            else
            {
                count = 0;
            }
        }

        if (start == -1)
        {
            printf("\nContiguous allocation failed.\n");
            printf("No sufficient continuous free space available.\n");
        }
        else
        {
            printf("\nAllocated blocks: ");

            for (i = start; i < start + fileSize; i++)
            {
                disk[i] = 1;
                printf("%d ", i);
            }

            printf("\n");
        }
    }

    /* LINKED */
    else if (method == 2)
    {
        count = 0;

        printf("\nAllocated blocks: ");

        for (i = 0; i < total && count < fileSize; i++)
        {
            if (disk[i] == 0)
            {
                disk[i] = 1;
                printf("%d", i);
                count++;

                if (count < fileSize)
                    printf(" -> ");
            }
        }

        if (count < fileSize)
        {
            printf("\nLinked allocation failed.\n");
        }
        else
        {
            printf(" -> NULL\n");
        }
    }

    /* INDEXED */
    else if (method == 3)
    {
        indexBlock = -1;

        /* Find index block */
        for (i = 0; i < total; i++)
        {
            if (disk[i] == 0)
            {
                indexBlock = i;
                disk[i] = 1;
                break;
            }
        }

        if (indexBlock == -1)
        {
            printf("\nIndexed allocation failed.\n");
            return 0;
        }

        count = 0;

        for (i = 0; i < total && count < fileSize; i++)
        {
            if (disk[i] == 0)
            {
                disk[i] = 1;
                count++;
            }
        }

        if (count < fileSize)
        {
            printf("\nIndexed allocation failed.\n");
            return 0;
        }

        printf("\nIndex block: %d\n", indexBlock);
        printf("Allocated data blocks: ");

        for (i = 0; i < total; i++)
        {
            if (disk[i] == 1 && i != indexBlock)
                printf("%d ", i);
        }

        printf("\n");
    }

    else
    {
        printf("Invalid allocation method.\n");
    }

    return 0;
}
