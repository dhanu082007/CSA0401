#include <stdio.h>
#include <fcntl.h>
#include <unistd.h>
#include <string.h>

int main()
{
    int fd;
    char write_data[] = "Hello, this is a UNIX file system call example.\n";
    char read_data[100];
    int n;

    // 1. Create and open the file
    fd = open("sample.txt", O_CREAT | O_RDWR, 0644);

    if (fd == -1)
    {
        perror("Error opening file");
        return 1;
    }

    printf("File opened successfully.\n");

    // 2. Write data to the file
    n = write(fd, write_data, strlen(write_data));

    if (n == -1)
    {
        perror("Error writing to file");
        close(fd);
        return 1;
    }

    printf("Data written successfully.\n");

    // 3. Move file pointer to beginning
    lseek(fd, 0, SEEK_SET);

    // 4. Read data from the file
    n = read(fd, read_data, sizeof(read_data) - 1);

    if (n == -1)
    {
        perror("Error reading file");
        close(fd);
        return 1;
    }

    read_data[n] = '\0';

    printf("Data read from file:\n%s", read_data);

    // 5. Close the file
    close(fd);

    printf("\nFile closed successfully.\n");

    return 0;
}
