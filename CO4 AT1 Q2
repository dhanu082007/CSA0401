#include <stdio.h>

#define MAX 1000

int main()
{
    int bitmap[MAX];
    int n, required;
    int i, count = 0;
    int deallocCount, block;

    printf("Enter total number of disk blocks: ");
    scanf("%d", &n);

    if (n > MAX)
    {
        printf("Maximum block limit exceeded.\n");
        return 0;
    }

    printf("Enter initial bitmap (0 = Free, 1 = Allocated):\n");

    for (i = 0; i < n; i++)
        scanf("%d", &bitmap[i]);

    printf("\nEnter number of blocks required: ");
    scanf("%d", &required);

    /* Count free blocks */
    for (i = 0; i < n; i++)
    {
        if (bitmap[i] == 0)
            count++;
    }

    if (count < required)
    {
        printf("\nAllocation failed.\n");
        printf("Only %d free blocks are available.\n", count);
        return 0;
    }

    /* Allocate blocks */
    count = 0;

    printf("\nAllocated blocks: ");

    for (i = 0; i < n && count < required; i++)
    {
        if (bitmap[i] == 0)
        {
            bitmap[i] = 1;
            printf("%d ", i);
            count++;
        }
    }

    printf("\n\nBitmap after allocation:\n");

    for (i = 0; i < n; i++)
        printf("%d ", bitmap[i]);

    /* Deallocation */
    printf("\n\nEnter number of blocks to deallocate: ");
    scanf("%d", &deallocCount);

    printf("Enter block numbers to deallocate:\n");

    for (i = 0; i < deallocCount; i++)
    {
        scanf("%d", &block);

        if (block >= 0 && block < n)
        {
            if (bitmap[block] == 1)
            {
                bitmap[block] = 0;
                printf("Block %d deallocated.\n", block);
            }
            else
            {
                printf("Block %d is already free.\n", block);
            }
        }
        else
        {
            printf("Invalid block number.\n");
        }
    }

    printf("\nBitmap after deallocation:\n");

    for (i = 0; i < n; i++)
        printf("%d ", bitmap[i]);

    printf("\n");

    return 0;
}
